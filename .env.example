# =============================================================================
# SiteFlow-Pro — environment variable schema
# Copy to .env.local for dev. Production values come from the platform's
# secret store (Vercel env / AWS Secrets Manager / GH Actions secrets).
# NEVER commit a real .env file. .env* (except .env.example) is in .gitignore.
# =============================================================================

# ----- Runtime ---------------------------------------------------------------
NODE_ENV=production
PORT=3000

# ----- Database (MySQL) ----------------------------------------------------
DATABASE_URL=

# ----- Sessions / cookies --------------------------------------------------
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# ----- Object storage (AWS S3) --------------------------------------------
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=               # optional, for R2/MinIO

# ----- Auth ----------------------------------------------------------------
OAUTH_SERVER_URL=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# ----- Analytics (Umami, exposed via Vite build) ---------------------------
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# ----- Observability --------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=siteflow-pro

# ----- Build-time (only read at build, baked into server bundle) ----------
BUILD_SHA=
BUILD_DATE=